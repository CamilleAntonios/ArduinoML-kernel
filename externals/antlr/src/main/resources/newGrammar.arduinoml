application unTestDecriture

# Ce scénario fait les choses suivantes :
# -définir un lecteur de température analogique
# -définit une alarme, qui est juste allumé ou non
# -définit une "ultraalarm", qui a une valeur analogique qui lui est donné pour varier son niveau d'alarme.
# L'algorithme est le suivant
# -de base, on ne fait rien.
#       -alors, si température > 35, on allume l'alarme (état "alarmon")
#       -mais si température est PLUS GRANDE que 75, on active l'état "ultraalarm", qui en plus d'allumer l'alarme
#       donne à l'ultra alarm la même valeur que la mesure de température

# Declaring bricks
actuator ultra : 7 analogical
sensor temperature : 9 analogical
actuator alarm : 12 digital

# Declaring states
INIT quiet {
    alarm <= LOW
    ultra <= 0
    if (temperature > 78 and temperature < 75) => alarmon
    if (not (temperature <= 75) ) => ultraalarmon # l'espace entre le "not" et ses parenthèses est optionnel
}

alarmon {
    alarm <= HIGH
    if (temperature <= 35) => quiet
}

ultraalarmon {
    alarm <= HIGH

    if (temperature <= 75) => alarmon
}